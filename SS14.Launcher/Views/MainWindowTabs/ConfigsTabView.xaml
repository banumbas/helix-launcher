<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mainWindowTabs="clr-namespace:SS14.Launcher.ViewModels.MainWindowTabs"
             xmlns:keybindConfigs="clr-namespace:SS14.Launcher.Models.KeybindConfigs"
             xmlns:loc="clr-namespace:SS14.Launcher.Localization"
             mc:Ignorable="d"
             d:DesignWidth="900"
             d:DesignHeight="540"
             x:Class="SS14.Launcher.Views.MainWindowTabs.ConfigsTabView">
  <Design.DataContext>
    <mainWindowTabs:ConfigsTabViewModel />
  </Design.DataContext>

  <UserControl.Styles>
    <Style Selector="Border.config-card">
      <Setter Property="Padding" Value="12" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="#1F2128" />
      <Setter Property="BorderBrush" Value="#333743" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Border.config-panel">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="BorderBrush" Value="#333743" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Border.config-badge">
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="Background" Value="#162235" />
      <Setter Property="BorderBrush" Value="#3D7DF0" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="TextBlock.config-heading">
      <Setter Property="Foreground" Value="#4286FF" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="18" />
    </Style>
  </UserControl.Styles>

  <DockPanel Margin="8">
    <Border DockPanel.Dock="Top"
            Padding="10"
            Classes="config-panel"
            Background="#1D1F26">
      <Grid ColumnDefinitions="*,Auto"
            RowDefinitions="Auto,Auto">
        <StackPanel Spacing="3">
          <TextBlock Text="{loc:Loc tab-configs-title}"
                     Classes="config-heading" />
          <TextBlock Text="{loc:Loc tab-configs-desc}"
                     Classes="SubText"
                     HorizontalAlignment="Left"
                     MaxWidth="520"
                     TextAlignment="Left"
                     TextWrapping="Wrap" />
          <TextBlock FontWeight="Bold">
            <Run Text="{loc:Loc tab-configs-active-label}" />
            <Run Text="{Binding ActiveConfigName}" />
          </TextBlock>
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Spacing="6"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal"
                      Spacing="6"
                      HorizontalAlignment="Right">
            <Button Content="{loc:Loc tab-configs-open-directory}"
                    Width="150"
                    Click="OpenConfigsDirectoryPressed" />
            <Button Content="{loc:Loc tab-configs-import-current}"
                    Width="150"
                    IsEnabled="{Binding CanImportCurrentKeybinds}"
                    Click="ImportCurrentKeybindsPressed" />
          </StackPanel>
          <StackPanel Orientation="Horizontal"
                      Spacing="6"
                      HorizontalAlignment="Right">
            <Button Content="{loc:Loc tab-configs-clear-selection}"
                    Width="150"
                    IsEnabled="{Binding HasSelectedConfig}"
                    Click="ClearSelectedConfigPressed" />
            <Button Content="{loc:Loc tab-configs-reload}"
                    Width="150"
                    Click="ReloadConfigsPressed" />
          </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="1"
                   Grid.ColumnSpan="2"
                   Margin="0,8,0,0"
                   Classes="SubText"
                   TextWrapping="Wrap">
          <Run Text="{loc:Loc tab-configs-directory-label}" />
          <Run Text=": " />
          <Run Text="{Binding ConfigsDirectory}" />
        </TextBlock>
      </Grid>
    </Border>

    <Border Margin="0,10,0,0"
            Padding="10"
            Classes="config-panel"
            Background="#17191F">
      <Grid>
        <TextBlock IsVisible="{Binding !HasConfigs}"
                   Text="{loc:Loc tab-configs-empty}"
                   TextWrapping="Wrap" />

        <ScrollViewer IsVisible="{Binding HasConfigs}"
                      HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Configs}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="keybindConfigs:KeybindConfigInfo">
                <Border Classes="config-card">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding Name}"
                                 FontWeight="Bold" />
                      <TextBlock Text="{Binding FileName}"
                                 Classes="SubText"
                                 TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="6"
                                VerticalAlignment="Center">
                      <Button Content="{loc:Loc tab-configs-selected}"
                              Focusable="False"
                              IsHitTestVisible="False"
                              IsVisible="{Binding Selected}"
                              Width="96"
                              Height="38" />
                      <Button Content="{loc:Loc tab-configs-select}"
                              Width="96"
                              Height="38"
                              IsVisible="{Binding !Selected}"
                              Click="SelectConfigPressed" />
                      <Button Width="40"
                              Height="38"
                              Padding="0"
                              ToolTip.Tip="{loc:Loc tab-configs-delete}"
                              Click="DeleteConfigPressed">
                        <Path Width="14"
                              Height="14"
                              Stretch="Uniform"
                              Fill="#E5E9F0"
                              Data="M 7 2 L 8 1 L 14 1 L 15 2 L 20 2 L 20 4 L 18 4 L 17 21 L 5 21 L 4 4 L 2 4 L 2 2 Z M 6 4 L 7 19 L 15 19 L 16 4 Z M 9 7 L 11 7 L 11 17 L 9 17 Z M 13 7 L 15 7 L 15 17 L 13 17 Z" />
                      </Button>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>
  </DockPanel>
</UserControl>
