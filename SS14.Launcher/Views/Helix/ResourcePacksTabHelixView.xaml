<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mainWindowTabs="clr-namespace:SS14.Launcher.ViewModels.MainWindowTabs"
             xmlns:resourcePacks="clr-namespace:SS14.Launcher.Models.ResourcePacks"
             xmlns:loc="clr-namespace:SS14.Launcher.Localization"
             mc:Ignorable="d"
             d:DesignWidth="1240"
             d:DesignHeight="720"
             x:Class="SS14.Launcher.Views.Helix.ResourcePacksTabHelixView">
  <Design.DataContext>
    <mainWindowTabs:ResourcePacksTabViewModel />
  </Design.DataContext>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="12">
      <Border Classes="HelixSectionCard"
              Padding="14">
        <Grid ColumnDefinitions="*,Auto"
              RowDefinitions="Auto,Auto">
          <StackPanel Spacing="5">
            <TextBlock Text="{loc:Loc tab-resource-packs-title}"
                       Classes="HelixSectionTitle" />
            <TextBlock Text="{loc:Loc tab-resource-packs-desc}"
                       Classes="HelixMuted"
                       HorizontalAlignment="Left"
                       MaxWidth="760"
                       TextAlignment="Left"
                       TextWrapping="Wrap" />
            <TextBlock Text="{loc:Loc tab-resource-packs-priority}"
                       Classes="HelixMuted"
                       TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      Spacing="8"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center">
            <Button Classes="HelixPillButton"
                    VerticalAlignment="Center"
                    Content="{loc:Loc tab-resource-packs-open-directory}"
                    Click="OpenResourcePackDirectoryPressed" />
            <Button Classes="HelixPillButton"
                    VerticalAlignment="Center"
                    Content="{loc:Loc tab-resource-packs-reload}"
                    Click="ReloadResourcePacksPressed" />
          </StackPanel>

          <TextBlock Grid.Row="1"
                     Grid.ColumnSpan="2"
                     Margin="0,10,0,0"
                     Classes="HelixMuted"
                     TextWrapping="Wrap">
            <Run Text="{loc:Loc tab-resource-packs-directory-label}" />
            <Run Text=": " />
            <Run Text="{Binding PacksDirectory}" />
          </TextBlock>
        </Grid>
      </Border>

      <Border Classes="HelixSectionCard"
              Padding="12">
        <Grid>
          <Border IsVisible="{Binding !HasResourcePacks}"
                  Classes="HelixInsetCard"
                  Padding="18">
            <TextBlock Text="{loc:Loc tab-resource-packs-empty}"
                       Classes="HelixMuted"
                       TextWrapping="Wrap" />
          </Border>

          <ScrollViewer IsVisible="{Binding HasResourcePacks}"
                        HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding ResourcePacks}"
                          HorizontalAlignment="Left"
                          Width="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="resourcePacks:ResourcePackInfo">
                  <Border Classes="HelixInsetCard"
                          Margin="0,0,0,8"
                          Padding="14">
                    <Grid ColumnDefinitions="*,Auto"
                          RowDefinitions="Auto,Auto">
                      <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Name}"
                                   Foreground="#E5E9F0"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock IsVisible="{Binding HasDescription}"
                                   Text="{Binding Description}"
                                   Classes="HelixMuted"
                                   HorizontalAlignment="Left"
                                   MaxWidth="760"
                                   TextAlignment="Left"
                                   TextWrapping="Wrap" />
                      </StackPanel>

                      <StackPanel Grid.Column="1"
                                  Grid.RowSpan="2"
                                  Margin="16,0,0,0"
                                  Orientation="Horizontal"
                                  Spacing="8"
                                  VerticalAlignment="Center">
                        <Button Classes="HelixPillButton"
                                Width="84"
                                Content="{loc:Loc tab-resource-packs-move-up}"
                                Click="MoveResourcePackUpPressed" />
                        <Button Classes="HelixPillButton"
                                Width="84"
                                Content="{loc:Loc tab-resource-packs-move-down}"
                                Click="MoveResourcePackDownPressed" />
                      </StackPanel>

                      <Grid Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,12,0,0"
                            ColumnDefinitions="Auto,Auto,*">
                        <CheckBox Classes="HelixCheck"
                                  IsChecked="{Binding Enabled, Mode=TwoWay}"
                                  Click="ResourcePackEnabledChanged"
                                  Content="{loc:Loc tab-resource-packs-enabled}"
                                  VerticalAlignment="Center" />

                        <TextBlock Grid.Column="1"
                                   Margin="14,0,0,0"
                                   Classes="HelixFieldLabel"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap">
                          <Run Text="{loc:Loc tab-resource-packs-folder-label}" />
                          <Run Text="{Binding DirectoryName}" />
                        </TextBlock>

                        <Border Grid.Column="2"
                                Classes="HelixBadge"
                                IsVisible="{Binding HasTargetForkId}"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center">
                          <TextBlock Foreground="#5C91F5"
                                     FontSize="11"
                                     FontWeight="SemiBold">
                            <Run Text="{loc:Loc tab-resource-packs-target-label}" />
                            <Run Text="{Binding TargetForkId}" />
                          </TextBlock>
                        </Border>
                      </Grid>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
